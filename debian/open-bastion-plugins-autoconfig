#!/usr/bin/perl
#
# open-bastion-plugins-autoconfig
#
# Bootstrap a LemonLDAP::NG configuration for an open-bastion deployment.
# Idempotent: only adds what is missing, except that it closes server
# enrollment when an existing pam-access RP lets any user approve it (see
# ensure_pam_rp). Use --force to overwrite existing values, --dry-run to
# preview, --verbose for details.
#
use strict;
use warnings;
use Getopt::Long qw(:config bundling);
use JSON;
use File::Temp qw(tempdir);
use Text::Wrap ();

use Lemonldap::NG::Common::Conf;

our $VERSION = '0.1.0';

my %opt = (
    'dry-run'           => 0,
    'force'             => 0,
    'verbose'           => 0,
    'custom-plugins'    => undef,     # undef = auto, 1 = force, 0 = never
    'help'              => 0,
    'rp-name'           => 'pam-access',
    'ssh-key-ref'       => 'ssh-ca',
    'ssh-dir'           => '/var/lib/lemonldap-ng/ssh',
    'server-admin-rule' => undef,     # undef = nobody may enroll a server
    'require-fingerprint' => 0,
);
GetOptions(
    \%opt,
    'dry-run|n',
    'force|f',
    'verbose|v',
    'custom-plugins!',
    'help|h',
    'rp-name=s',
    'ssh-key-ref=s',
    'ssh-dir=s',
    'server-admin-rule=s',
    'require-fingerprint',
) or usage(2);
usage(0) if $opt{help};
if (defined $opt{'server-admin-rule'}) {
    $opt{'server-admin-rule'} =~ s/^\s+|\s+$//g;
    fatal('--server-admin-rule must not be empty (omit it to deny everyone)')
        if $opt{'server-admin-rule'} eq '';
}

sub usage {
    my $code = shift // 0;
    print <<"EOF";
Usage: $0 [options]

Bootstrap LemonLDAP::NG for an open-bastion deployment. Idempotent.

Options:
  -n, --dry-run             Show what would change, do not save.
  -f, --force               Overwrite existing values (default: keep them).
  -v, --verbose             Print each decision.
      --custom-plugins      Force injection in customPlugins.
      --no-custom-plugins   Never touch customPlugins.
      --rp-name NAME        OIDC RP client_id for pam-access (default: pam-access).
      --ssh-key-ref NAME    Ref of the SSH CA key in 'keys' (default: ssh-ca).
      --ssh-dir DIR         Serial/KRL dir (default: /var/lib/lemonldap-ng/ssh).
      --server-admin-rule RULE
                            Rule of the users allowed to enroll servers, e.g.
                            'inGroup("server-admins")'. Default: nobody.
      --require-fingerprint Set pamAccessRequireFingerprint (certificate-only
                            deployments: it refuses token and desktop logins).
  -h, --help                This message.
EOF
    exit $code;
}

my @changes;   # list of human-readable change descriptions
my @kept;      # list of unchanged keys (verbose only)

sub log_change { push @changes, $_[0]; print "  + $_[0]\n" if $opt{verbose} }
sub log_keep   { push @kept,    $_[0]; print "  = $_[0]\n" if $opt{verbose} }
sub log_info   { print "  i $_[0]\n" if $opt{verbose} }
# Security-relevant: printed whatever --verbose says.
sub log_warn   { print "  ! $_[0]\n" }
sub fatal      { print STDERR "ERROR: $_[0]\n"; exit 1 }

# --- Helpers ---------------------------------------------------------------

# Set a top-level key only if missing (or if --force). Returns 1 if changed.
sub set_if_missing {
    my ($conf, $key, $value, $label) = @_;
    $label //= $key;
    if (!exists $conf->{$key} || $opt{force}) {
        if (exists $conf->{$key} && _eq($conf->{$key}, $value)) {
            log_keep($label);
            return 0;
        }
        $conf->{$key} = $value;
        log_change($label);
        return 1;
    }
    log_keep($label);
    return 0;
}

sub _eq {
    my ($a, $b) = @_;
    return 0 if ref($a) ne ref($b);
    if (!ref($a)) {
        return (defined $a && defined $b && "$a" eq "$b")
            || (!defined $a && !defined $b);
    }
    my $canon = JSON->new->canonical(1)->utf8(0);
    return $canon->encode($a) eq $canon->encode($b);
}

# Run a command (list form, no shell), capture stdout+stderr, die on error.
sub run_cmd {
    my (@cmd) = @_;
    log_info("run: @cmd");
    my $pid = open(my $fh, '-|');
    defined $pid or fatal("cannot fork for @cmd: $!");
    if ($pid == 0) {
        # child: merge stderr into stdout, then exec the target
        open(STDERR, '>&', \*STDOUT)
            or print STDERR "cannot dup stderr: $!\n" and exit 127;
        exec({ $cmd[0] } @cmd) or print STDERR "exec failed: $!\n" and exit 127;
    }
    local $/;
    my $out = <$fh>;
    close($fh);
    if ($? != 0) {
        my $exit = $? >> 8;
        my $sig  = $? & 0x7f;
        my $msg  = "command failed (exit $exit"
                 . ($sig ? ", signal $sig" : "") . "): @cmd";
        $msg .= "\n-- output --\n$out" if defined $out && length $out;
        fatal($msg);
    }
    return $out;
}

# --- Step: detect Autoloader and LLNG version -----------------------------

sub detect_autoloader {
    my $has_autoloader = eval {
        require Lemonldap::NG::Portal::Plugins::Autoloader;
        1;
    };
    my $llng_version = eval {
        require Lemonldap::NG::Common;
        $Lemonldap::NG::Common::VERSION;
    } || '0.0.0';
    log_info("LLNG version: $llng_version");
    log_info("Autoloader module available: " . ($has_autoloader ? 'yes' : 'no'));
    return ($has_autoloader, $llng_version);
}

# Compare version strings like "2.24.0" lexically-by-parts.
sub version_lt {
    my ($a, $b) = @_;
    my @a = split /\./, ($a =~ /^(\d+(?:\.\d+)*)/)[0] // '0';
    my @b = split /\./, ($b =~ /^(\d+(?:\.\d+)*)/)[0] // '0';
    while (@a || @b) {
        my $x = shift @a // 0;
        my $y = shift @b // 0;
        return 1 if $x < $y;
        return 0 if $x > $y;
    }
    return 0;
}

# --- Step: decide which modules to add to customPlugins -------------------

sub plan_custom_plugins {
    my ($has_autoloader, $llng_version) = @_;

    my @all_plugins = (
        '::Plugins::PamAccess',
        '::Plugins::SSHCA',
        '::Plugins::OIDCDeviceAuthorization',
        '::Plugins::OIDCDeviceOrganization',
    );

    # Explicit user overrides
    if (defined $opt{'custom-plugins'}) {
        if ($opt{'custom-plugins'}) {
            log_info('customPlugins: --custom-plugins → force-adding 4 plugins');
            return [@all_plugins];
        }
        log_info('customPlugins: --no-custom-plugins → skipped');
        return [];
    }

    if ($has_autoloader) {
        if (version_lt($llng_version, '2.24.0')) {
            # Module available but not in default @pList
            log_info("customPlugins: LLNG < 2.24.0 with Autoloader module → add Autoloader");
            return ['::Plugins::Autoloader'];
        }
        # Autoloader is in default @pList
        log_info("customPlugins: LLNG >= 2.24.0 → Autoloader is default, nothing to add");
        return [];
    }

    # No Autoloader at all: fallback to explicit plugin list
    log_info("customPlugins: no Autoloader → add 4 plugins manually");
    return [@all_plugins];
}

sub apply_custom_plugins {
    my ($conf, $modules) = @_;
    return 0 unless @$modules;

    # LLNG parses customPlugins with /[,\s]+/ (see
    # Lemonldap::NG::Portal::Main::Plugins), so both comma- and space-
    # separated lists are accepted. Use the same rule when detecting
    # already-present modules and preserve the admin's existing
    # separator style when re-serialising.
    my $current  = $conf->{customPlugins} // '';
    my @existing = grep { length } map { s/^\s+|\s+$//gr } split /[,\s]+/, $current;
    my %present  = map { $_ => 1 } @existing;
    my @to_add   = grep { !$present{$_} } @$modules;

    if (!@to_add) {
        log_keep('customPlugins (all modules already present)');
        return 0;
    }

    my $sep = ($current =~ /,/) ? ', ' : ' ';
    my $new = join($sep, @existing, @to_add);
    $conf->{customPlugins} = $new;
    log_change("customPlugins += " . join(', ', @to_add));
    return 1;
}

# --- Step: OIDC service activation & keys ---------------------------------

sub ensure_oidc_service {
    my ($conf) = @_;

    set_if_missing($conf, 'issuerDBOpenIDConnectActivation', 1,
        'issuerDBOpenIDConnectActivation');

    my %defaults = (
        oidcServiceMetaDataAuthorizeURI     => 'authorize',
        oidcServiceMetaDataTokenURI         => 'token',
        oidcServiceMetaDataUserInfoURI      => 'userinfo',
        oidcServiceMetaDataJWKSURI          => 'jwks',
        oidcServiceMetaDataEndSessionURI    => 'logout',
        oidcServiceMetaDataIntrospectionURI => 'introspect',
        oidcServiceMetaDataRegistrationURI  => 'register',
        oidcServiceMetaDataCheckSessionURI  => 'check_session',
        oidcServiceMetaDataRevokeURI        => 'revoke',
        oidcServiceAllowAuthorizationCodeFlow => 1,
        oidcServiceAllowImplicitFlow        => 1,
        oidcServiceAllowHybridFlow          => 1,

        oidcServiceDeviceAuthorizationExpiration     => 600,
        oidcServiceDeviceAuthorizationPollingInterval => 5,
        oidcServiceDeviceAuthorizationUserCodeLength => 8,
    );
    for my $k (sort keys %defaults) {
        set_if_missing($conf, $k, $defaults{$k}, $k);
    }

    # Service signing keys
    my $has_priv = $conf->{oidcServicePrivateKeySig};
    my $has_pub  = $conf->{oidcServicePublicKeySig};
    my $had_kid  = $conf->{oidcServiceKeyIdSig};
    if (!$has_priv || !$has_pub || $opt{force}) {
        log_info('Generating OIDC service RSA 2048 signing keys');
        my ($priv, $pub) = generate_oidc_keys();
        $conf->{oidcServicePrivateKeySig} = $priv;
        $conf->{oidcServicePublicKeySig}  = $pub;
        $conf->{oidcServiceKeyIdSig}      = _random_hex(8);
        log_change('oidcServicePrivateKeySig (generated)');
        log_change('oidcServicePublicKeySig (generated)');
        log_change('oidcServiceKeyIdSig' . ($had_kid ? ' (rotated)' : ' (generated)'));
    } else {
        log_keep('oidcServicePrivateKeySig');
        log_keep('oidcServicePublicKeySig');
        set_if_missing($conf, 'oidcServiceKeyIdSig', _random_hex(8),
            'oidcServiceKeyIdSig')
            unless $had_kid;
    }
}

sub generate_oidc_keys {
    my $dir = tempdir(CLEANUP => 1);
    run_cmd('openssl', 'genrsa', '-out', "$dir/priv.pem", '2048');
    run_cmd('openssl', 'req', '-new', '-x509',
            '-key', "$dir/priv.pem",
            '-out', "$dir/cert.pem",
            '-days', '3650',
            '-subj', '/CN=LemonLDAP-NG');
    my $priv = _slurp("$dir/priv.pem");
    my $pub  = _slurp("$dir/cert.pem");
    chomp $priv; chomp $pub;
    return ($priv, $pub);
}

# --- Step: RP pam-access --------------------------------------------------

# Enrolling a server is approving a device-authorization request on this RP:
# whoever approves it gives the host its PAM identity, and the host can then
# query /pam/authorize for any user. Three settings decide who that is, and
# they all take the same rule:
#
# - oidcRPMetaDataOptionsAllowDeviceAuthorization, a boolOrExpr evaluated
#   against the approving user's session. `1` means ANY authenticated user
#   (oidc-device-authorization README, "Who may approve an enrollment"); `0`
#   turns the device grant off for the RP.
# - the `pam` and `pam:server` scope rules, also evaluated against the
#   approving user. A rule of `1` grants the scope even when the device did
#   not ask for it, and PamAccess accepts either scope, so both are set: one
#   left at `1` would undo the other.
#
# There is no sensible default population, so the default is to deny, as for
# sshCaAdminRule below: the admin passes --server-admin-rule (or edits the RP)
# to let server administrators enroll hosts.
sub server_admin_rule {
    return $opt{'server-admin-rule'} // 0;
}

# A value this script may replace on an existing RP: the bootstrap
# placeholders. `1` (anyone) is always replaced, because it is the unsafe
# default the script used to write; `0`/empty/absent (nobody) only when the
# admin asked for a rule on the command line. An expression is the admin's and
# is never touched (short of --force).
sub _trim {
    my $v = shift;
    return undef unless defined $v;
    $v = "$v";
    $v =~ s/^\s+|\s+$//g;
    return $v;
}
sub _is_open        { my $v = _trim(shift); defined $v && $v eq '1' }
sub _is_placeholder { my $v = _trim(shift); !defined $v || $v =~ /\A[01]?\z/ }
sub _is_closed      { my $v = _trim(shift); !defined $v || $v =~ /\A0?\z/ }

sub ensure_pam_rp {
    my ($conf) = @_;
    my $rp   = $opt{'rp-name'};
    my $rule = server_admin_rule();

    my $opts = {
        oidcRPMetaDataOptionsDisplayName            => 'PAM Access',
        oidcRPMetaDataOptionsClientID               => $rp,
        oidcRPMetaDataOptionsClientSecret           => '',
        oidcRPMetaDataOptionsPublic                 => 1,
        oidcRPMetaDataOptionsRequirePKCE            => 2,
        oidcRPMetaDataOptionsAllowDeviceAuthorization => $rule,
        oidcRPMetaDataOptionsAccessTokenExpiration  => 86400,
        oidcRPMetaDataOptionsRefreshToken           => 1,
        oidcRPMetaDataOptionsIDTokenExpiration      => 3600,
    };
    my $vars = {
        uid    => 'uid',
        email  => 'mail',
        name   => 'cn',
        groups => 'groups',
    };
    my $scopes = {
        pam          => "$rule",
        'pam:server' => "$rule",
    };

    $conf->{oidcRPMetaDataOptions}     //= {};
    $conf->{oidcRPMetaDataExportedVars} //= {};
    $conf->{oidcRPMetaDataScopeRules}  //= {};

    if (!exists $conf->{oidcRPMetaDataOptions}{$rp} || $opt{force}) {
        $conf->{oidcRPMetaDataOptions}{$rp}     = $opts;
        $conf->{oidcRPMetaDataExportedVars}{$rp} = $vars;
        $conf->{oidcRPMetaDataScopeRules}{$rp}   = $scopes;
        log_change("oidcRPMetaDataOptions.$rp");
        log_change("oidcRPMetaDataExportedVars.$rp");
        log_change("oidcRPMetaDataScopeRules.$rp");
        log_info("server enrollment on RP '$rp' denies everyone: see the "
            . 'checklist below') unless $rule;
        log_warn("--server-admin-rule 1 lets ANY authenticated user enroll a "
            . 'server') if _is_open($rule);
    } else {
        # RP treated as atomic: if the admin has it defined we leave it
        # alone -- except for who may enroll a server, below.
        log_keep("oidcRPMetaDataOptions.$rp");
        log_keep("oidcRPMetaDataExportedVars.$rp");
        log_keep("oidcRPMetaDataScopeRules.$rp");
        log_warn("--server-admin-rule 1 lets ANY authenticated user enroll "
            . 'a server')
            if lock_pam_rp_enrollment($conf, $rp, $rule) && _is_open($rule);
    }
}

# Existing RP: replace the open (`1`) enrollment settings with $rule, and the
# closed ones too when the admin gave --server-admin-rule. Already-enrolled
# servers are not affected: these settings are only read while a new device
# is enrolled, and refresh tokens keep the scope they were issued with.
sub lock_pam_rp_enrollment {
    my ($conf, $rp, $rule) = @_;
    my $explicit = defined $opt{'server-admin-rule'};
    my $o   = $conf->{oidcRPMetaDataOptions}{$rp} //= {};
    my $key = 'oidcRPMetaDataOptionsAllowDeviceAuthorization';
    my $cur = $o->{$key};

    # An approver expression already restricts enrollment: the admin's.
    if (!_is_placeholder($cur)) {
        log_info("oidcRPMetaDataOptions.$rp.$key is an expression, kept"
            . ($explicit && "$cur" ne "$rule"
                ? ' (--server-admin-rule ignored; use --force to replace)'
                : ''));
        return 0;
    }
    # Device grant disabled and no rule asked for: nothing can be enrolled.
    return 0 unless _is_open($cur) || $explicit;

    my $wrote = 0;
    my $was = $cur // '(unset)';
    if (!_eq($cur, $rule)) {
        $wrote = 1;
        $o->{$key} = $rule;
        log_change("oidcRPMetaDataOptions.$rp.$key: $was -> $rule");
        log_warn("RP '$rp': $key was $was, now $rule") if _is_open($cur);
    }

    my $s = $conf->{oidcRPMetaDataScopeRules}{$rp} //= {};
    for my $scope ('pam', 'pam:server') {
        my $v = $s->{$scope};
        next unless _is_placeholder($v);
        next if defined $v && _trim($v) eq "$rule";
        $wrote = 1;
        $s->{$scope} = "$rule";
        log_change("oidcRPMetaDataScopeRules.$rp.$scope: "
            . ($v // '(unset)') . " -> $rule");
    }
    return $wrote;
}

# --- Step: SSH CA ---------------------------------------------------------

sub ensure_ssh_ca {
    my ($conf) = @_;
    my $ref = $opt{'ssh-key-ref'};

    $conf->{keys} //= {};
    if (!exists $conf->{keys}{$ref} || $opt{force}) {
        log_info("Generating SSH CA ed25519 key for ref '$ref'");
        my ($priv, $pub) = generate_ed25519_key();
        $conf->{keys}{$ref} = {
            keyPrivate => $priv,
            keyPublic  => $pub,
            keyComment => 'LLNG SSH CA (open-bastion-plugins)',
        };
        log_change("keys.$ref (generated)");
    } else {
        log_keep("keys.$ref");
    }

    # sshCaCertMaxValidity is in DAYS (see SSHCA.pm). 1 day = short-lived
    # certificates, aligned with an open-bastion workflow where users
    # re-issue certs frequently via the portal.
    my %defaults = (
        sshCaActivation       => 1,
        sshCaKeyRef           => $ref,
        sshCaCertMaxValidity  => 1,
        sshCaPrincipalSources => '$uid',
        sshCaKrlPath          => "$opt{'ssh-dir'}/revoked_keys",
    );
    for my $k (sort keys %defaults) {
        set_if_missing($conf, $k, $defaults{$k}, $k);
    }

    # SSH CA administration: default-deny, admin fills the rule later -- same
    # convention as pamAccessSshRules below. /ssh/admin, /ssh/certs and
    # /ssh/revoke list and revoke EVERY user's certificates, so there is no
    # sensible default here; the plugin denies when the rule is unset, and we
    # write the 0 explicitly so the deny is visible in the configuration and
    # in this script's log rather than being an absence nobody notices.
    # Per-user endpoints (/ssh/sign, /ssh/mycerts, /ssh/myrevoke) are not
    # affected.
    if (set_if_missing($conf, 'sshCaAdminRule', 0, 'sshCaAdminRule')) {
        log_info('sshCaAdminRule denies everyone: set it (e.g. '
                 . 'inGroup("ssh-admins")) to grant SSH CA administration');
    }
}

sub generate_ed25519_key {
    my $dir = tempdir(CLEANUP => 1);
    run_cmd('openssl', 'genpkey', '-algorithm', 'ed25519',
            '-out', "$dir/priv.pem");
    run_cmd('openssl', 'pkey', '-in', "$dir/priv.pem",
            '-pubout', '-out', "$dir/pub.pem");
    my $priv = _slurp("$dir/priv.pem");
    my $pub  = _slurp("$dir/pub.pem");
    chomp $priv; chomp $pub;
    return ($priv, $pub);
}

# --- Step: PAM access -----------------------------------------------------

# Whether hosts may already be enrolled: the PAM RP exists. Decides whether
# pamAccessAllowedRps can be written safely (see ensure_pam_access). Must be
# called before ensure_pam_rp creates the RP.
sub pam_already_deployed {
    my ($conf) = @_;
    my $rps = $conf->{oidcRPMetaDataOptions} || {};
    return 1 if exists $rps->{ $opt{'rp-name'} };
    my $r = $conf->{pamAccessRp};
    return 1 if defined $r && length $r && exists $rps->{$r};
    return 0;
}

sub ensure_pam_access {
    my ($conf, $deployed) = @_;
    my %defaults = (
        pamAccessActivation        => 1,
        pamAccessRp                => $opt{'rp-name'},
        pamAccessTokenDuration     => 600,
        pamAccessMaxDuration       => 3600,
        pamAccessHeartbeatInterval => 300,
        pamAccessOfflineEnabled    => 1,
        pamAccessOfflineTtl        => 86400,
    );
    for my $k (sort keys %defaults) {
        set_if_missing($conf, $k, $defaults{$k}, $k);
    }
    # The RP PamAccess actually uses: an existing pamAccessRp wins over
    # --rp-name, and the allowlist below must name that one.
    my $rp = _trim($conf->{pamAccessRp});
    $rp = $opt{'rp-name'} unless defined $rp && length $rp;

    # SSH: default-deny, admin fills per-group rules later.
    # Sudo: intentionally not initialised. In an open-bastion deployment
    # sudo authorization is not driven by pamAccessSudoRules but by a
    # regular /etc/sudoers entry granting privileges to a Unix group
    # populated on the fly through NSS from pamAccessExportedVars.groups.
    # Absent config key => plugin returns sudo_allowed:0, which is the
    # safe default.
    if (!exists $conf->{pamAccessSshRules} || $opt{force}) {
        $conf->{pamAccessSshRules} = { default => 'deny' };
        log_change('pamAccessSshRules = { default: "deny" }');
    } else {
        log_keep('pamAccessSshRules');
    }

    # Exported vars: minimal useful set for PAM NSS
    if (!exists $conf->{pamAccessExportedVars} || $opt{force}) {
        $conf->{pamAccessExportedVars} = {
            uid   => 'uid',
            cn    => 'cn',
            mail  => 'mail',
            gecos => 'cn',
        };
        log_change('pamAccessExportedVars');
    } else {
        log_keep('pamAccessExportedVars');
    }

    # pamAccessAllowedRps: the RPs whose tokens may call /pam/*. Empty (the
    # plugin default) accepts any device-grant token carrying a pam scope,
    # whatever RP issued it, and lets a host declare itself a bastion in the
    # request body. Setting it refuses that self-declared bastion group too,
    # so a bastion then needs a client_id of its own mapped in
    # pamAccessServerGroups.
    #
    # On a new deployment nothing is enrolled yet: write it. Where the PAM RP
    # already existed, hosts may be enrolled, possibly under other RPs and
    # with bastions declaring their group in the body; writing it would cut
    # them off, so only say what is missing.
    # The Manager may have saved the empty default, so '' counts as unset.
    my $allowed = $conf->{pamAccessAllowedRps};
    my $empty   = !defined $allowed || $allowed eq '';
    if ($opt{force} || ($empty && !$deployed)) {
        if (_eq($allowed, $rp)) {
            log_keep('pamAccessAllowedRps');
        } else {
            $conf->{pamAccessAllowedRps} = $rp;
            log_change("pamAccessAllowedRps = $rp");
        }
    } elsif ($empty) {
        log_warn('pamAccessAllowedRps is empty and the PAM RP already '
            . 'existed: not set, as it would cut off hosts enrolled under '
            . 'another RP and bastions that declare their own group. See '
            . 'the checklist below');
    } else {
        log_keep('pamAccessAllowedRps');
    }

    # pamAccessRequireFingerprint is opt-in: it is portal-wide and refuses
    # every /pam/verify and /pam/authorize without an SSH fingerprint, i.e.
    # token-mode (password) logins, desktop logins and offline revalidation,
    # which never carry one.
    if ($opt{'require-fingerprint'}) {
        if (!$conf->{pamAccessRequireFingerprint}) {
            $conf->{pamAccessRequireFingerprint} = 1;
            log_change('pamAccessRequireFingerprint');
        } else {
            log_keep('pamAccessRequireFingerprint');
        }
    }
}

# --- Checklist ------------------------------------------------------------

# What open-bastion requires before production (its UPGRADE-NOTES, "B0", and
# share/ob-portal-prerequisites.txt) and this script does not, or cannot, set.
# Printed on every run, from the configuration as it stands after the run.
sub print_checklist {
    my ($conf) = @_;
    my $rp  = $opt{'rp-name'};
    my $ro  = ($conf->{oidcRPMetaDataOptions} || {})->{$rp} || {};
    my $who = $ro->{oidcRPMetaDataOptionsAllowDeviceAuthorization};
    my @items;

    if (_is_closed($who)) {
        push @items, ['todo', "Server enrollment on RP '$rp' denies "
            . 'everyone. To let administrators enroll hosts, set '
            . 'oidcRPMetaDataOptionsAllowDeviceAuthorization and the pam and '
            . 'pam:server scope rules of the RP to their rule, e.g. '
            . 'inGroup("server-admins"), or re-run with --server-admin-rule.'];
    } elsif (_is_open($who)) {
        push @items, ['RISK', "Server enrollment on RP '$rp' is open to ANY "
            . 'authenticated user, who can then query /pam/authorize for every '
            . 'account. Set oidcRPMetaDataOptionsAllowDeviceAuthorization and '
            . 'the pam and pam:server scope rules to an administrators\' rule.'];
    } else {
        push @items, ['ok', "Server enrollment on RP '$rp' restricted to: $who"];
    }

    my $allowed = $conf->{pamAccessAllowedRps} // '';
    push @items, $allowed ne ''
        ? ['ok', "pamAccessAllowedRps = $allowed"]
        : ['RISK', 'pamAccessAllowedRps is empty: any device-grant token with '
            . 'a pam scope reaches /pam/*, and any enrolled host can declare '
            . "itself a bastion. List the PAM RPs (e.g. $rp) once every host "
            . 'enrolled under another RP and every bastion is accounted for.'];

    my $sg = $conf->{pamAccessServerGroups};
    push @items, (ref $sg eq 'HASH' && %$sg)
        ? ['ok', 'pamAccessServerGroups maps '
            . join(', ', map { "$_ -> $sg->{$_}" } sort keys %$sg)]
        : ['todo', 'pamAccessServerGroups is empty: the server group comes '
            . 'from the request body. Before adding a bastion, enroll it '
            . 'under an RP of its own (enrollment restricted as above), add '
            . 'that RP to pamAccessAllowedRps and map its client_id to the '
            . 'bastion group here; once the map is set, every enrolled '
            . 'client_id must be in it.'];

    push @items, ['todo', 'On every backend host, /etc/open-bastion/'
        . 'allowed_bastions must be non-empty: ob-backend-setup '
        . '--allowed-bastions <bastion_id>[,<id>...]. An empty file accepts '
        . 'a voucher from any bastion. Not checkable from the portal.'];

    push @items, $conf->{pamAccessRequireFingerprint}
        ? ['ok', 'pamAccessRequireFingerprint is on']
        : ['opt', 'pamAccessRequireFingerprint is off: turn it on '
            . '(--require-fingerprint) once every host logs users in with SSH '
            . 'certificates and runs the fingerprint spool. It refuses '
            . 'token-mode (password) and desktop logins.'];

    push @items, $conf->{pamAccessBastionCertPinSourceAddress}
        ? ['ok', 'pamAccessBastionCertPinSourceAddress is on']
        : ['opt', 'pamAccessBastionCertPinSourceAddress is off: turn it on '
            . 'when there is no NAT between bastions and backends.'];

    print "\n== Open Bastion: before production ==\n";
    local $Text::Wrap::columns  = 78;
    local $Text::Wrap::unexpand = 0;
    for my $i (@items) {
        my $tag = sprintf '  [%-4s] ', $i->[0];
        print Text::Wrap::wrap($tag, ' ' x length($tag), $i->[1]), "\n";
    }
    print "  See open-bastion's UPGRADE-NOTES.md (B0) and "
        . "doc/security/09-portail-llng.rst.\n";
}

# --- Utils ----------------------------------------------------------------

sub _slurp {
    my $path = shift;
    open(my $fh, '<', $path) or fatal("cannot read $path: $!");
    local $/;
    my $c = <$fh>;
    close($fh);
    return $c;
}

sub _random_hex {
    my $n = shift;
    open(my $fh, '<', '/dev/urandom') or fatal("cannot open /dev/urandom: $!");
    my $raw = '';
    my $got = 0;
    while ($got < $n) {
        my $r = read($fh, $raw, $n - $got, $got);
        defined $r or fatal("cannot read /dev/urandom: $!");
        $r > 0    or fatal("short read from /dev/urandom");
        $got += $r;
    }
    close($fh);
    return unpack('H*', $raw);
}

# --- Main -----------------------------------------------------------------

print "open-bastion-plugins-autoconfig $VERSION\n";
print "Mode: " . ($opt{'dry-run'} ? 'DRY-RUN' : 'APPLY')
    . ($opt{force} ? ' (FORCE)' : '') . "\n";

my $confAccess = Lemonldap::NG::Common::Conf->new()
    or fatal("cannot access LLNG configuration: "
        . $Lemonldap::NG::Common::Conf::msg);

my $conf = $confAccess->getConf({ noCache => 1, raw => 1 })
    or fatal("cannot load current configuration: "
        . $Lemonldap::NG::Common::Conf::msg);

my $old_cfg_num = $conf->{cfgNum} // '0';
log_info("current cfgNum: $old_cfg_num");

# Detect Autoloader / LLNG version
my ($has_autoloader, $llng_version) = detect_autoloader();
my $modules = plan_custom_plugins($has_autoloader, $llng_version);

# Before anything creates the RP
my $pam_deployed = pam_already_deployed($conf);
log_info('PAM RP already present: existing deployment') if $pam_deployed;

# Apply changes in order
ensure_oidc_service($conf);
ensure_pam_rp($conf);
ensure_ssh_ca($conf);
ensure_pam_access($conf, $pam_deployed);
apply_custom_plugins($conf, $modules);

# Author & metadata
$conf->{cfgAuthor}    = 'open-bastion-plugins-autoconfig';
$conf->{cfgAuthorIP}  = '127.0.0.1';
$conf->{cfgDate}      = time;
$conf->{cfgLog}       = 'Bootstrap for open-bastion (autoconfig)';

print "\n== Summary ==\n";
printf "  changes: %d\n", scalar @changes;
printf "  kept:    %d\n", scalar @kept;
print_checklist($conf);
if ($opt{'dry-run'}) {
    print "\nDry-run: no save performed. Re-run without --dry-run to apply.\n";
    exit 0;
}

if (!@changes) {
    print "\nNothing to do. Configuration already up to date.\n";
    exit 0;
}

my $n = $confAccess->saveConf($conf);
if ($n <= 0) {
    fatal("saveConf failed: " . $Lemonldap::NG::Common::Conf::msg);
}

print "\nConfiguration saved as cfgNum $n.\n";
print "Next: restart/reload the portal if your backend requires it.\n";
exit 0;

__END__

=head1 NAME

open-bastion-plugins-autoconfig - Bootstrap LLNG for open-bastion

=head1 SYNOPSIS

  open-bastion-plugins-autoconfig [--dry-run] [--force] [--verbose]
      [--server-admin-rule RULE] [--require-fingerprint]

=head1 DESCRIPTION

Idempotently configures a LemonLDAP::NG instance for an open-bastion
deployment: OIDC service keys, the pam-access OIDC RP (public + PKCE),
the SSH CA key and activation flags for the PAM Access and SSH CA
plugins.

Server enrollment is closed by default: the RP's
C<oidcRPMetaDataOptionsAllowDeviceAuthorization> and its C<pam> and
C<pam:server> scope rules are set to B<--server-admin-rule>, or to C<0>
(nobody) without it. On a new deployment C<pamAccessAllowedRps> is set to the
RP. A checklist of what remains to be done before production
(C<pamAccessServerGroups>, C<allowed_bastions> on the backends...) is printed
on every run.

Safe to re-run: existing values are preserved unless B<--force> is given,
with one exception, on an existing RP. When its device authorization setting
is C<1> (any user may approve an enrollment: what earlier versions of this
script wrote), or C<0> and B<--server-admin-rule> is given, that setting and
the C<pam> / C<pam:server> scope rules that are C<0>, C<1> or unset are
replaced by the rule above. Expressions are kept. Servers already enrolled
keep working.
C<pamAccessAllowedRps> is never added to an existing deployment: the
checklist says what to set.

=cut
