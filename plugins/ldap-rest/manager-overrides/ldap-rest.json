{
    "authPlugin": {
        "k": "LdapRest",
        "v": "LDAP (ldap-rest)",
        "roles": ["passwordDB"]
    },
    "attributes": {
        "registerDB": {
            "select": [{ "k": "LdapRest", "v": "LDAP (ldap-rest)" }]
        },
        "ldapRestUrl": {
            "type": "url",
            "documentation": "ldap-rest base URL",
            "help": "passwordldaprest.html"
        },
        "ldapRestResource": {
            "type": "text",
            "default": "users",
            "documentation": "ldap-rest flat resource name",
            "help": "passwordldaprest.html"
        },
        "ldapRestMainAttribute": {
            "type": "text",
            "default": "uid",
            "documentation": "ldap-rest mainAttribute of the resource",
            "help": "passwordldaprest.html"
        },
        "ldapRestIdKey": {
            "type": "text",
            "default": "",
            "documentation": "Session key holding the ldap-rest entry id (empty means DN)",
            "help": "passwordldaprest.html"
        },
        "ldapRestPasswordAttribute": {
            "type": "text",
            "default": "userPassword",
            "documentation": "LDAP attribute updated by ldap-rest",
            "help": "passwordldaprest.html"
        },
        "ldapRestPasswordHash": {
            "type": "select",
            "select": [
                { "k": "", "v": "noHash" },
                { "k": "SSHA", "v": "SSHA" },
                { "k": "SSHA256", "v": "SSHA256" },
                { "k": "SSHA512", "v": "SSHA512" },
                { "k": "SHA", "v": "SHA" },
                { "k": "SHA256", "v": "SHA256" },
                { "k": "SHA512", "v": "SHA512" }
            ],
            "default": "",
            "documentation": "Client side password hashing scheme",
            "help": "passwordldaprest.html"
        },
        "ldapRestAuthMode": {
            "type": "select",
            "select": [
                { "k": "none", "v": "none" },
                { "k": "token", "v": "Bearer token" },
                { "k": "hmac", "v": "HMAC-SHA256" }
            ],
            "default": "none",
            "documentation": "ldap-rest authentication mode",
            "help": "passwordldaprest.html"
        },
        "ldapRestToken": {
            "type": "password",
            "default": "",
            "documentation": "ldap-rest bearer token",
            "help": "passwordldaprest.html"
        },
        "ldapRestHmacId": {
            "type": "text",
            "default": "",
            "documentation": "ldap-rest HMAC service id",
            "help": "passwordldaprest.html"
        },
        "ldapRestHmacSecret": {
            "type": "password",
            "default": "",
            "documentation": "ldap-rest HMAC shared secret",
            "help": "passwordldaprest.html"
        }
    },
    "tree": [
        {
            "insert_into": "generalParameters/plugins",
            "nodes": [
                {
                    "title": "ldapRestParams",
                    "help": "passwordldaprest.html",
                    "form": "simpleInputContainer",
                    "nodes": [
                        "ldapRestUrl",
                        "ldapRestResource",
                        "ldapRestMainAttribute",
                        "ldapRestIdKey",
                        "ldapRestPasswordAttribute",
                        "ldapRestPasswordHash",
                        "ldapRestAuthMode",
                        "ldapRestToken",
                        "ldapRestHmacId",
                        "ldapRestHmacSecret"
                    ]
                }
            ]
        }
    ],
    "lang": {
        "ldapRestParams": {
            "en": "ldap-rest parameters",
            "fr": "Paramètres ldap-rest",
            "es": "Parámetros de ldap-rest",
            "it": "Parametri ldap-rest"
        },
        "ldapRestUrl": {
            "en": "ldap-rest base URL",
            "fr": "URL de base ldap-rest",
            "es": "URL base de ldap-rest",
            "it": "URL di base di ldap-rest"
        },
        "ldapRestResource": {
            "en": "Resource name",
            "fr": "Nom de la ressource",
            "es": "Nombre del recurso",
            "it": "Nome della risorsa"
        },
        "ldapRestMainAttribute": {
            "en": "Resource main attribute",
            "fr": "Attribut principal de la ressource",
            "es": "Atributo principal del recurso",
            "it": "Attributo principale della risorsa"
        },
        "ldapRestIdKey": {
            "en": "Entry id session key",
            "fr": "Clé de session de l'identifiant d'entrée",
            "es": "Clave de sesión del identificador de entrada",
            "it": "Chiave di sessione dell'ID della voce"
        },
        "ldapRestPasswordAttribute": {
            "en": "Password attribute",
            "fr": "Attribut de mot de passe",
            "es": "Atributo de contraseña",
            "it": "Attributo della password"
        },
        "ldapRestPasswordHash": {
            "en": "Password hash scheme",
            "fr": "Schéma de hachage du mot de passe",
            "es": "Esquema de hash de la contraseña",
            "it": "Schema di hash della password"
        },
        "ldapRestAuthMode": {
            "en": "ldap-rest authentication",
            "fr": "Authentification ldap-rest",
            "es": "Autenticación de ldap-rest",
            "it": "Autenticazione ldap-rest"
        },
        "ldapRestToken": {
            "en": "Bearer token",
            "fr": "Jeton Bearer",
            "es": "Token Bearer",
            "it": "Token Bearer"
        },
        "ldapRestHmacId": {
            "en": "HMAC service id",
            "fr": "Identifiant de service HMAC",
            "es": "ID de servicio HMAC",
            "it": "ID del servizio HMAC"
        },
        "ldapRestHmacSecret": {
            "en": "HMAC shared secret",
            "fr": "Secret partagé HMAC",
            "es": "Secreto compartido HMAC",
            "it": "Segreto condiviso HMAC"
        },
        "noHash": {
            "en": "No hashing (server side)",
            "fr": "Pas de hachage (côté serveur)",
            "es": "Sin hash (lado del servidor)",
            "it": "Nessun hash (lato server)"
        }
    }
}
