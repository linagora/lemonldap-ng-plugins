{
  "attributes": {
    "oidcFederationEnabled": {
      "type": "bool",
      "default": 0,
      "documentation": "Enable OpenID Federation support"
    },
    "oidcFederationEntityId": {
      "type": "text",
      "documentation": "OpenID Federation entity identifier (defaults to issuer URL)"
    },
    "oidcFederationAuthorityHints": {
      "type": "text",
      "documentation": "OpenID Federation authority hints (space-separated entity IDs)"
    },
    "oidcFederationSigningKey": {
      "type": "text",
      "default": "default-oidc-sig",
      "documentation": "Key ID used for signing federation entity statements"
    },
    "oidcFederationSigningAlg": {
      "type": "select",
      "select": [
        { "k": "RS256", "v": "RS256" },
        { "k": "RS384", "v": "RS384" },
        { "k": "RS512", "v": "RS512" },
        { "k": "ES256", "v": "ES256" },
        { "k": "ES384", "v": "ES384" },
        { "k": "ES512", "v": "ES512" }
      ],
      "default": "RS256",
      "documentation": "Algorithm for signing federation entity statements"
    },
    "oidcFederationTrustAnchors": {
      "type": "keyTextContainer",
      "default": {},
      "documentation": "OpenID Federation trust anchors (entity ID => JWKS JSON)"
    },
    "oidcFederationFetchTimeout": {
      "type": "int",
      "default": 5,
      "documentation": "Timeout in seconds for federation HTTP fetches"
    },
    "oidcFederationAllowPrivateHosts": {
      "type": "bool",
      "default": 0,
      "documentation": "Allow federation fetches to loopback, private and link-local addresses (not recommended)"
    },
    "oidcFederationCacheTTL": {
      "type": "int",
      "default": 60,
      "documentation": "Seconds to cache trust chain resolutions, including negative results (0 disables)"
    },
    "oidcRPMetaDataOptionsFederationEntityId": {
      "type": "text",
      "documentation": "OpenID Federation entity identifier for this RP"
    }
  },
